{
  "$id": "account.reverse.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "撤销一笔转账的扣款(补偿)(命令,版本 1,主体 = data.transfer_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "lines": {
          "description": "要撤销的账户和金额(和扣款时相同)",
          "items": {
            "properties": {
              "account_id": {
                "type": "string"
              },
              "amount": {
                "pattern": "^-?[0-9]+$",
                "type": "string"
              }
            },
            "required": [
              "account_id",
              "amount"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        },
        "transfer_id": {
          "description": "转账号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "transfer_id",
        "lines"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "account.reverse"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "account.reverse",
  "type": "object",
  "x-factory": {
    "type": "account.reverse",
    "kind": "command",
    "version": 1,
    "subject": "transfer_id",
    "desc": "撤销一笔转账的扣款(补偿)",
    "fields": [
      {
        "name": "transfer_id",
        "type": "整数64",
        "required": true,
        "desc": "转账号",
        "rules": {
          "范围": "1~999999999"
        }
      },
      {
        "name": "lines",
        "type": "列表",
        "required": true,
        "desc": "要撤销的账户和金额(和扣款时相同)",
        "rules": {
          "个数": "1~10"
        },
        "elem": [
          {
            "name": "account_id",
            "type": "文本",
            "required": true,
            "rules": {
              "格式": "代码",
              "长度": "3~32"
            }
          },
          {
            "name": "amount",
            "type": "整数64",
            "required": true,
            "rules": {
              "范围": "1~1000000"
            }
          }
        ],
        "unique": [
          "account_id"
        ]
      }
    ]
  }
}
