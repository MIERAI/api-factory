{
  "$id": "account.settled.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "结算完成(事件,版本 1,主体 = data.transfer_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "transfer_id": {
          "description": "转账号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "transfer_id"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "account.settled"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "account.settled",
  "type": "object",
  "x-factory": {
    "type": "account.settled",
    "kind": "event",
    "version": 1,
    "subject": "transfer_id",
    "desc": "结算完成",
    "fields": [
      {
        "name": "transfer_id",
        "type": "整数64",
        "required": true,
        "desc": "转账号"
      }
    ]
  }
}
