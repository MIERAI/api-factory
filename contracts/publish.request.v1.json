{
  "$id": "publish.request.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "请发布服务发布一个文档的版本(重发是幂等的)(命令,版本 1,主体 = data.doc_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "doc_id": {
          "description": "文档号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        "revision": {
          "description": "发布的版本",
          "type": "integer"
        }
      },
      "required": [
        "doc_id",
        "revision"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "publish.request"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "publish.request",
  "type": "object",
  "x-factory": {
    "type": "publish.request",
    "kind": "command",
    "version": 1,
    "subject": "doc_id",
    "desc": "请发布服务发布一个文档的版本(重发是幂等的)",
    "fields": [
      {
        "name": "doc_id",
        "type": "整数64",
        "required": true,
        "desc": "文档号",
        "rules": {
          "范围": "\u003e 0"
        }
      },
      {
        "name": "revision",
        "type": "整数32",
        "required": true,
        "desc": "发布的版本",
        "rules": {
          "范围": "1~1000"
        }
      }
    ]
  }
}
