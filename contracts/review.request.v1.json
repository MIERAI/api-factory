{
  "$id": "review.request.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "请评审人审批一个文档(同一个文档、同一个版本可能重发多次)(命令,版本 1,主体 = data.doc_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "doc_id": {
          "description": "文档号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        "reviewers": {
          "description": "评审人",
          "items": {
            "properties": {
              "reviewer": {
                "type": "string"
              },
              "weight": {
                "type": "integer"
              }
            },
            "required": [
              "reviewer",
              "weight"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        },
        "revision": {
          "description": "要审批的版本",
          "type": "integer"
        },
        "title": {
          "description": "标题",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "revision",
        "title",
        "reviewers"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "review.request"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "review.request",
  "type": "object",
  "x-factory": {
    "type": "review.request",
    "kind": "command",
    "version": 1,
    "subject": "doc_id",
    "desc": "请评审人审批一个文档(同一个文档、同一个版本可能重发多次)",
    "fields": [
      {
        "name": "doc_id",
        "type": "整数64",
        "required": true,
        "desc": "文档号",
        "rules": {
          "范围": "\u003e 0"
        }
      },
      {
        "name": "revision",
        "type": "整数32",
        "required": true,
        "desc": "要审批的版本",
        "rules": {
          "范围": "1~1000"
        }
      },
      {
        "name": "title",
        "type": "文本",
        "required": true,
        "desc": "标题",
        "rules": {
          "长度": "1~100"
        }
      },
      {
        "name": "reviewers",
        "type": "列表",
        "required": true,
        "desc": "评审人",
        "rules": {
          "个数": "1~10"
        },
        "elem": [
          {
            "name": "reviewer",
            "type": "文本",
            "required": true,
            "rules": {
              "长度": "2~32"
            }
          },
          {
            "name": "weight",
            "type": "整数32",
            "required": true,
            "rules": {
              "范围": "1~5"
            }
          }
        ],
        "unique": [
          "reviewer"
        ]
      }
    ]
  }
}
