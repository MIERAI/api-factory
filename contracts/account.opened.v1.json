{
  "$id": "account.opened.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "开了一个账户(事件,版本 1,主体 = data.account_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "account_id": {
          "description": "账户 id",
          "type": "string"
        },
        "balance": {
          "description": "开户金额",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        "opened_at": {
          "description": "开户时间",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "balance",
        "opened_at"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "account.opened"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "account.opened",
  "type": "object",
  "x-factory": {
    "type": "account.opened",
    "kind": "event",
    "version": 1,
    "subject": "account_id",
    "desc": "开了一个账户",
    "fields": [
      {
        "name": "account_id",
        "type": "文本",
        "required": true,
        "desc": "账户 id",
        "rules": {
          "格式": "代码",
          "长度": "3~32"
        }
      },
      {
        "name": "balance",
        "type": "整数64",
        "required": true,
        "desc": "开户金额",
        "rules": {
          "范围": "0~1000000000"
        }
      },
      {
        "name": "opened_at",
        "type": "时间",
        "required": true,
        "desc": "开户时间"
      }
    ]
  }
}
