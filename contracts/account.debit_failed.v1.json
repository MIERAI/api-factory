{
  "$id": "account.debit_failed.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "扣款失败(这条命令没有新扣任何账户;同一笔转账以前记过的扣款不变)(事件,版本 1,主体 = data.transfer_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "reason": {
          "description": "原因: INSUFFICIENT_FUNDS / REVERSED",
          "type": "string"
        },
        "transfer_id": {
          "description": "转账号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "transfer_id",
        "reason"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "account.debit_failed"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "account.debit_failed",
  "type": "object",
  "x-factory": {
    "type": "account.debit_failed",
    "kind": "event",
    "version": 1,
    "subject": "transfer_id",
    "desc": "扣款失败(这条命令没有新扣任何账户;同一笔转账以前记过的扣款不变)",
    "fields": [
      {
        "name": "transfer_id",
        "type": "整数64",
        "required": true,
        "desc": "转账号"
      },
      {
        "name": "reason",
        "type": "文本",
        "required": true,
        "desc": "原因: INSUFFICIENT_FUNDS / REVERSED",
        "rules": {
          "长度": "1~32"
        }
      }
    ]
  }
}
