{
  "$id": "review.rejected.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "评审人驳回了文档(事件,版本 1,主体 = data.doc_id)。Code generated by factory from 消息.yaml",
  "properties": {
    "data": {
      "properties": {
        "doc_id": {
          "description": "文档号",
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        "reason": {
          "description": "驳回的理由",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "reason"
      ],
      "type": "object"
    },
    "id": {
      "description": "UUIDv7(平台生成;重发时不变)",
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    },
    "type": {
      "const": "review.rejected"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "source",
    "subject",
    "data"
  ],
  "title": "review.rejected",
  "type": "object",
  "x-factory": {
    "type": "review.rejected",
    "kind": "event",
    "version": 1,
    "subject": "doc_id",
    "desc": "评审人驳回了文档",
    "fields": [
      {
        "name": "doc_id",
        "type": "整数64",
        "required": true,
        "desc": "文档号",
        "rules": {
          "范围": "\u003e 0"
        }
      },
      {
        "name": "reason",
        "type": "文本",
        "required": true,
        "desc": "驳回的理由",
        "rules": {
          "长度": "1~200"
        }
      }
    ]
  }
}
