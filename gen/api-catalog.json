[
  {
    "id": "catalog.get-product-label",
    "method": "GetProductLabel",
    "summary": "商品コードとラベルコードを指定して、ラベルの現在の文言を返す。なければ found = false",
    "path": "/factory.catalog.v1.CatalogService/GetProductLabel",
    "pattern": "get_by_id",
    "cases": [
      {
        "name": "最新の版の文言(found = true)",
        "request": {
          "label_code": "A",
          "product_code": "100"
        },
        "response": {
          "found": true,
          "text": "特売2"
        }
      },
      {
        "name": "削除されたラベルは「ない」(エラーではなく found = false)",
        "request": {
          "label_code": "B",
          "product_code": "100"
        },
        "response": {
          "found": false
        }
      },
      {
        "name": "登録のないラベルも found = false",
        "request": {
          "label_code": "A",
          "product_code": "999"
        },
        "response": {
          "found": false
        }
      }
    ]
  },
  {
    "id": "catalog.list-labels-by-label-codes",
    "method": "ListLabelsByLabelCodes",
    "summary": "ラベルコード(複数)を指定して、全商品のそのラベルの現在の文言を返す。商品コードの前方一致で絞れる",
    "path": "/factory.catalog.v1.CatalogService/ListLabelsByLabelCodes",
    "pattern": "list_all",
    "cases": [
      {
        "name": "現在の版、削除されたものは出ない",
        "request": {
          "label_codes": [
            "A"
          ]
        },
        "response": {
          "product_label": [
            {
              "product_code": "100",
              "text": "特売2"
            },
            {
              "product_code": "200",
              "text": "新"
            }
          ]
        }
      },
      {
        "name": "複数のコード + 前方一致",
        "request": {
          "label_codes": [
            "A",
            "B"
          ],
          "product_prefix": "2"
        },
        "response": {
          "product_label": [
            {
              "label_code": "A",
              "product_code": "200"
            },
            {
              "label_code": "B",
              "product_code": "200"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "catalog.list-labels-by-pairs",
    "method": "ListLabelsByPairs",
    "summary": "(商品コード, ラベルコード) の組のリストを受け取り、組ごとのラベルの現在の文言を返す",
    "path": "/factory.catalog.v1.CatalogService/ListLabelsByPairs",
    "pattern": "list_all",
    "cases": [
      {
        "name": "組ごとに一致するものだけ(100/B と 200/A は掛け合わせなので返さない)",
        "request": {
          "pairs": [
            {
              "label_code": "A",
              "product_code": "100"
            },
            {
              "label_code": "B",
              "product_code": "200"
            }
          ]
        },
        "response": {
          "product_label": [
            {
              "label_code": "A",
              "product_code": "100",
              "text": "特売"
            },
            {
              "label_code": "B",
              "product_code": "200",
              "text": "再入荷"
            }
          ]
        }
      },
      {
        "name": "ラベルコードが空(既定のラベル)の行は、空文字の組とは一致しない",
        "request": {
          "pairs": [
            {
              "label_code": "",
              "product_code": "300"
            }
          ]
        },
        "response": {
          "product_label": []
        }
      },
      {
        "name": "同じ組を 2 回書いても 1 件",
        "request": {
          "pairs": [
            {
              "label_code": "B",
              "product_code": "100"
            },
            {
              "label_code": "B",
              "product_code": "100"
            }
          ]
        },
        "response": {
          "product_label": [
            {
              "label_code": "B",
              "product_code": "100",
              "text": "新商品"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "catalog.list-product-labels",
    "method": "ListProductLabels",
    "summary": "商品コードを指定して、その商品のラベル(既定のラベルを含む)の現在の値を返す",
    "path": "/factory.catalog.v1.CatalogService/ListProductLabels",
    "pattern": "list_all",
    "cases": [
      {
        "name": "既定のラベル(ラベルコードが空)も 1 件として、新しい版を返す。空は最後に並ぶ",
        "request": {
          "product_code": "100"
        },
        "response": {
          "product_label": [
            {
              "display_text": "特売",
              "label": "A"
            },
            {
              "display_text": "既定2",
              "label": null
            }
          ]
        }
      },
      {
        "name": "既定のラベルが削除された商品は、残りのラベルだけ",
        "request": {
          "product_code": "200"
        },
        "response": {
          "product_label": [
            {
              "display_text": "新商品",
              "label": "B"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "catalog.list-product-master",
    "method": "ListProductMaster",
    "summary": "カテゴリと商品コードを条件に、商品マスタの現在の値を返す",
    "path": "/factory.catalog.v1.CatalogService/ListProductMaster",
    "pattern": "list_all",
    "cases": [
      {
        "name": "現在の値だけ。削除された B は返さない(古い版に戻らない)。論理削除された C は次の例(veg)で確認",
        "request": {
          "category": "fruit"
        },
        "response": {
          "product_master": [
            {
              "launched_on": "2026-01-01",
              "name": "りんご2",
              "price": "120",
              "product_code": "A"
            },
            {
              "category": "fruit",
              "product_code": "D"
            }
          ]
        }
      },
      {
        "name": "筛选は現在の値に対して行う。D の古い版は veg だが、今は fruit なので veg では返さない",
        "request": {
          "category": "veg"
        },
        "response": {
          "product_master": []
        }
      }
    ]
  },
  {
    "id": "catalog.list-products-by-category",
    "method": "ListProductsByCategory",
    "summary": "カテゴリを指定して、現在の商品を安い順に返す。最低価格で絞れる",
    "path": "/factory.catalog.v1.CatalogService/ListProductsByCategory",
    "pattern": "list_all",
    "cases": [
      {
        "name": "現在の価格で安い順、同じ価格は商品コード順。削除された商品は出ない",
        "request": {
          "category": "fruit"
        },
        "response": {
          "product_master": [
            {
              "product_code": "B"
            },
            {
              "price": "120",
              "product_code": "A"
            },
            {
              "product_code": "C"
            }
          ]
        }
      },
      {
        "name": "最低価格(含)",
        "request": {
          "category": "fruit",
          "min_price": "120"
        },
        "response": {
          "product_master": [
            {
              "product_code": "A"
            },
            {
              "product_code": "C"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "catalog.list-recent-label-changes",
    "method": "ListRecentLabelChanges",
    "summary": "商品コードを指定して、その商品のラベルを最後に変わった順に返す(いつ変わったかも返す)",
    "path": "/factory.catalog.v1.CatalogService/ListRecentLabelChanges",
    "pattern": "list_all",
    "cases": [
      {
        "name": "最後に変わった順(A は 1/3 に変わったので先)",
        "request": {
          "product_code": "100"
        },
        "response": {
          "product_label": [
            {
              "changed_at": "2026-01-03T00:00:00Z",
              "label_code": "A",
              "text": "特売2"
            },
            {
              "changed_at": "2026-01-02T00:00:00Z",
              "label_code": "B",
              "text": "新商品"
            }
          ]
        }
      },
      {
        "name": "指定時刻以降に変わったものだけ(最新の版の時刻で判断する)",
        "request": {
          "changed_since": "2026-01-02T12:00:00Z",
          "product_code": "100"
        },
        "response": {
          "product_label": [
            {
              "changed_at": "2026-01-03T00:00:00Z",
              "label_code": "A",
              "text": "特売2"
            }
          ]
        }
      }
    ]
  },
  {
    "id": "jobs.get-job-status",
    "method": "GetJobStatus",
    "summary": "按 id 返回一个任务的处理状态",
    "path": "/factory.jobs.v1.JobService/GetJobStatus",
    "pattern": "get_by_id",
    "cases": [
      {
        "name": "普通的 id",
        "request": {
          "job_id": 102
        },
        "response": {
          "status": "JOB_STATUS_SUCCEEDED"
        }
      },
      {
        "name": "超过 32 位整数范围的 id 也能查到",
        "request": {
          "job_id": 3000000000
        },
        "response": {
          "status": "JOB_STATUS_FAILED"
        }
      }
    ]
  },
  {
    "id": "jobs.get-job-summary",
    "method": "GetJobSummary",
    "summary": "按任务类型和期间,汇总任务的处理情况",
    "path": "/factory.jobs.v1.JobService/GetJobSummary",
    "pattern": "compute",
    "cases": [
      {
        "name": "alpha — 0.95 刚好 OK,期间边界外不计",
        "request": {
          "job_type": "alpha",
          "period_end": "2026-11-08T00:00:00Z",
          "period_start": "2026-11-01T00:00:00Z"
        },
        "response": {
          "avg_duration_seconds": 60,
          "failed": 1,
          "health": "OK",
          "pending": 0,
          "sla_breaches": 0,
          "succeeded": 19,
          "success_rate": 0.95,
          "total": 20
        }
      },
      {
        "name": "beta — 300 秒不算违约 / 数据不一致的行 / 0.75 CRITICAL",
        "request": {
          "job_type": "beta",
          "period_end": "2026-11-08T00:00:00Z",
          "period_start": "2026-11-01T00:00:00Z"
        },
        "response": {
          "avg_duration_seconds": 233.7,
          "failed": 1,
          "health": "CRITICAL",
          "pending": 1,
          "sla_breaches": 1,
          "succeeded": 3,
          "success_rate": 0.75,
          "total": 5
        }
      },
      {
        "name": "gamma — 全部未完成 → NO_DATA,比率和平均不设置",
        "request": {
          "job_type": "gamma",
          "period_end": "2026-11-08T00:00:00Z",
          "period_start": "2026-11-01T00:00:00Z"
        },
        "response": {
          "avg_duration_seconds": "$absent",
          "failed": 0,
          "health": "NO_DATA",
          "pending": 2,
          "sla_breaches": 0,
          "succeeded": 0,
          "success_rate": "$absent",
          "total": 2
        }
      }
    ]
  },
  {
    "id": "jobs.list-failed-jobs",
