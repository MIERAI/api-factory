  {
    "id": "logistics.list-shipments-by-day",
    "method": "ListShipmentsByDay",
    "summary": "指定した出荷日の出荷を、倉庫名と配送業者名つきで返す(分页なし)",
    "path": "/factory.logistics.v1.LogisticService/ListShipmentsByDay",
    "pattern": "list_all",
    "cases": [
      {
        "name": "倉庫マスタに無い倉庫(W9)・業者マスタに無いコード(P99)の出荷も返す。名前は不设置",
        "request": {
          "shipped_on": "2026-11-20"
        },
        "response": {
          "shipments": [
            {
              "carrier_name": "山川運輸",
              "id": 1,
              "partner_code": "P01",
              "warehouse_name": "東倉庫",
              "weight": "12.5"
            },
            {
              "carrier_name": "$absent",
              "id": 2,
              "partner_code": "$absent",
              "warehouse_code": "W9",
              "warehouse_name": "$absent"
            },
            {
              "carrier_name": "$absent",
              "id": 3,
              "partner_code": "P99",
              "warehouse_name": "西倉庫",
              "weight": "0.25"
            }
          ]
        }
      },
      {
        "name": "取引先コードが空の出荷は、取引先コードが空の業者(自社便)とは結びつかない(空どうしは等しくない)",
        "request": {
          "shipped_on": "2026-11-20",
          "warehouse_codes": [
            "W9"
          ]
        },
        "response": {
          "shipments": [
            {
              "carrier_name": "$absent",
              "id": 2
            }
          ]
        }
      },
      {
        "name": "倉庫で絞り込む",
        "request": {
          "shipped_on": "2026-11-21",
          "warehouse_codes": [
            "W1",
            "W2"
          ]
        },
        "response": {
          "shipments": [
            {
              "carrier_name": "山川運輸",
              "id": 4,
              "warehouse_name": "東倉庫"
            }
          ]
        }
      }
    ]
  },
  {
