# Migration image (built with the API image in the same release: schema and code versions match). Runs as the
# api-factory Deployment's init container: goose migrations (db/migrations, embedded) on factory + shards, before the
# API starts — also after a database is re-created. SEED=demo (dev): demo data (db/seed, embedded).
# Base image through mirror.gcr.io (Docker Hub's official images, cached; no anonymous pull limit). --build-arg IMAGE_MIRROR=… to change
ARG IMAGE_MIRROR=mirror.gcr.io/library
FROM ${IMAGE_MIRROR}/golang:1.27.4-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY db ./db
COPY cmd/migrate ./cmd/migrate
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/migrate /migrate
USER nonroot:nonroot
ENTRYPOINT ["/migrate"]
CMD ["up"]
