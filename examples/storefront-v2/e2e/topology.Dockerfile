# The platform's pre-deploy step for messaging (GAPS G23): the runtime's CLI applies the system topology manifest
# (../contracts/topology.json, generated by `factory system`) before any service starts. Built from this checkout's
# runtime (runtime/, context = the repository root): the same runtime the projects build against.
# Base image through mirror.gcr.io (Docker Hub's official images, cached; no anonymous pull limit)
ARG IMAGE_MIRROR=mirror.gcr.io/library
ARG GO_VERSION
FROM ${IMAGE_MIRROR}/golang:${GO_VERSION}-alpine AS build
WORKDIR /runtime
COPY runtime ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/factory-runtime ./cmd/factory-runtime

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/factory-runtime /factory-runtime
USER nonroot:nonroot
ENTRYPOINT ["/factory-runtime"]
