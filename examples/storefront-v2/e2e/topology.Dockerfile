# The platform's pre-deploy step for messaging (GAPS G23): the runtime's CLI applies the system topology manifest
# (../contracts/topology.json, generated by `factory system`) before any service starts. RUNTIME_VERSION = the runtime
# the projects are generated against (the Makefile reads it from driver/go.mod).
# Base image through mirror.gcr.io (Docker Hub's official images, cached; no anonymous pull limit)
ARG IMAGE_MIRROR=mirror.gcr.io/library
FROM ${IMAGE_MIRROR}/golang:1.27.4-alpine AS build
ARG RUNTIME_VERSION
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    test -n "$RUNTIME_VERSION" && CGO_ENABLED=0 GOBIN=/out go install -trimpath -ldflags "-s -w" \
    github.com/MIERAI/api-factory-runtime/cmd/factory-runtime@${RUNTIME_VERSION}

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/factory-runtime /factory-runtime
USER nonroot:nonroot
ENTRYPOINT ["/factory-runtime"]
