[
  {
    "id": "order.get-order",
    "method": "GetOrder",
    "summary": "返回一个订单和它的明细(按行号)",
    "path": "/order.order.v1.OrderService/GetOrder",
    "pattern": "get_by_id",
    "cases": [
      {
        "name": "明细按行号返回,金额 = 数量 × 单价(十进制按文本,不丢精度)",
        "request": {
          "id": 1
        },
        "response": {
          "created_at": "2026-11-01T00:00:00Z",
          "customer_id": 7,
          "id": 1,
          "items": [
            {
              "amount": "2000.00",
              "line_no": 1,
              "price": "1000.00",
              "qty": 2,
              "sku": "BEAN-001"
            },
            {
              "amount": "1250",
              "line_no": 2,
              "price": "1250",
              "qty": 1,
              "sku": "BEAN-002"
            }
          ],
          "status": "ORDER_STATUS_CONFIRMED",
          "total": "3250"
        }
      },
      {
        "name": "没有明细的订单 → 空列表",
        "request": {
          "id": 2
        },
        "response": {
          "id": 2,
          "items": [],
          "status": "ORDER_STATUS_PENDING"
        }
      }
    ]
  },
  {
    "id": "order.list-orders-by-customer",
    "method": "ListOrdersByCustomer",
    "summary": "返回一个顾客的订单(新到旧,分页),每个订单带明细的行数和明细金额的合计",
    "path": "/order.order.v1.OrderService/ListOrdersByCustomer",
    "pattern": "list_keyset",
    "cases": [
      {
        "name": "新到旧(同一时刻按订单号大到小);没有明细的订单件数 0、合计 0;合计是精确的十进制(0.1 + 0.2 = 0.3)",
        "request": {
          "customer_id": 7
        },
        "response": {
          "orders": [
            {
              "id": 3,
              "item_count": 2,
              "items_total": "0.3",
              "status": "ORDER_STATUS_PENDING"
            },
            {
              "id": 2,
              "item_count": 0,
              "items_total": "0",
              "status": "ORDER_STATUS_CANCELLED"
            },
            {
              "id": 1,
              "item_count": 2,
              "items_total": "3250",
              "status": "ORDER_STATUS_CONFIRMED",
              "total": "3250"
            }
          ]
        }
      },
      {
        "name": "没有订单的顾客",
        "request": {
          "customer_id": 9
        },
        "response": {
          "orders": []
        }
      }
    ]
  }
]
